# Local: `bun run db:up` starts this Postgres (docker-compose.yml).
# Production (Railway): Supabase's session pooler URL (port 5432, not 6543) with ?sslmode=require.
DATABASE_URL=postgres://pulso:pulso@localhost:5438/pulso_concept
PORT=3000
# The admin page's password (/admin). At least 12 characters.
ADMIN_PASSWORD=
# Signs admin sessions; changing it signs everyone out. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
# Comma-separated origins allowed to call the API (the Vercel domains and local Vite).
WEB_ORIGINS=http://localhost:5173
LOG_LEVEL=info
