{
  "name": "pulso-concept",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@pulso-concept/api' --filter '@pulso-concept/web' dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p . && bun run --filter '*' typecheck",
    "test": "bun test",
    "db:up": "docker compose up -d --wait postgres",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate:local",
    "push": "git add . && git commit -m \"update: alterações no projeto\" && git push origin main"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "railway": "^3.16.0",
    "typescript": "^7.0.2"
  }
}
